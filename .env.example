# انسخ الملف ده إلى .env وغيّر القيم (الملف .env مش بيترفع على GitHub)

# PostgreSQL
POSTGRES_DB=lunx
POSTGRES_USER=lunx
POSTGRES_PASSWORD=غيّر-كلمة-السر-دي

# مفتاح الجلسات — نص عشوائي طويل. ولّده بـ:  python -c "import secrets;print(secrets.token_hex(32))"
LUNX_SECRET=غيّر-المفتاح-ده

# كلمة سر admin أول مرة بس (بعد كده بتتغير من داخل النظام)
LUNX_ADMIN_PASSWORD=admin123

# المنفذ على الجهاز
LUNX_PORT=5050

# 1 لو السيرفر ورا Nginx/Traefik/Caddy ، و LUNX_COOKIE_SECURE=1 لو الرابط HTTPS
LUNX_BEHIND_PROXY=0
LUNX_COOKIE_SECURE=0

# عدد النسخ الاحتياطية اليومية اللي بتتحفظ
LUNX_BACKUP_KEEP=30

# عدد عمليات gunicorn
WORKERS=3

# 0 = صورة أصغر من غير LibreOffice (بدون تحويل PDF)
WITH_PDF=1
